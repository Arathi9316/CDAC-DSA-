package linkedlizt;
import java.util.*;
class CycleList extends LinkedLst{
	private intNode head;
	public CycleList() {
		head=null;
	}
	
	public void insertFirst(int d) {
		super.insertFirst(d);
	}
	
	public void display() {
		super.display();
	}
	public void insertLast(int d) {
		super.insertLast(d);
	}
	public void insertSorted(int d) {
		super.insertSorted(d);
	}
	public int deleteFirst() {
		return super.deleteFirst();
	}
	public int deleteLast() {
		return super.deleteLast();
	}
	
	public void fromCycle(int d) {
		intNode prev=null,psave = null,temp=head;
		while(temp!=null) {
			prev=temp;
			if(temp.getData()==d)
				psave=temp;
			temp=temp.getNext();
		}
		prev.setNext(psave);
	}
}

