package linkedlizt;
import java.util.*;

class CycleList extends LinkedLst{
	private intNode head;
	public CycleList() {
		head=null;
	}
	
	public void formCycle(int d) {
		intNode psave = null;
		intNode temp=head;
		while(temp.getNext()!=null) {
			if(temp.getData()==d) psave=temp;
			temp=temp.getNext();
		}
		temp.setNext(psave);
	
	public void detectCycle() {
		intNode slow,fast,c=null;
		slow=fast=head;
		while(fast!=null&&fast.getNext()!=null) {
			slow=slow.getNext();
			fast=fast.getNext().getNext();
			if(slow==fast)break;
			c=slow;
		}
		System.out.println("Cycle detected at node whose data is: "+c);
	}
}


