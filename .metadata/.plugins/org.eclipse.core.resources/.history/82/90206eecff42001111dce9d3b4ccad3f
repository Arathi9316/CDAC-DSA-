package linkedlizt;

import java.util.Scanner;

class intDoubly{
	private int data;
	private intDoubly prev,next;
	public intDoubly() {
		data=0;
		prev=next=null;
	}
	public intDoubly(int d) {
		data=d;
		prev=next=null;
	}
	public int getData() {
		return data;
	}
	public void setData(int data) {
		this.data = data;
	}
	public intDoubly getPrev() {
		return prev;
	}
	public void setPrev(intDoubly prev) {
		this.prev = prev;
	}
	public intDoubly getNext() {
		return next;
	}
	public void setNext(intDoubly next) {
		this.next = next;
	}
	
}

class DoublyyList{
	private intDoubly head;
	
	public DoublyyList() {
		head=null;
	}
	public void insertFirst(int d) {
		intDoubly new_node=new intDoubly(d);
		if(head==null) {
			head=new_node;
			return;
		}
		new_node.setNext(head);
		head.setPrev(new_node);
		head=new_node;
		return;
	}
	public void insertLast(int d) {
		intDoubly new_node=new intDoubly(d);
		if(head==null) {
			head=new_node;
			return;
		}
		intDoubly itr=head;
		while(itr.getNext()!=null) {
			itr=itr.getNext();
		}
		new_node.setPrev(itr);
		itr.setNext(new_node);
		return;
		
	}
	public void insertByPos(int d,int p) {
		intDoubly new_node=new intDoubly(d);
		if(head==null) {
			head=new_node;
			return;
		}
		if(p==1) {
			new_node.setNext(head);
			head.setPrev(new_node);
			head=new_node;
			return;
		}
		intDoubly itr=head;
		for(int i=0;i<p-1&&itr.getNext()!=null;i++) {
			itr=itr.getNext();
		}
		new_node.setNext(itr.getNext());
		new_node.setPrev(itr.getPrev());
		if(itr.getNext()!=null)
			itr.getNext().setPrev(new_node);
		itr.setNext(new_node);
		return;
	}
	public int deleteFirst() {
		int d=-999;
		if(head==null) {
			System.out.println("List empty!");
			return d;
		}
		
		intDoubly deletable=head;
		d=deletable.getData();
		head=deletable.getNext();
		deletable.setNext(null);
		deletable=null;
		return d;
	}
	public int deleteLast() {
		int d=-999;
		if(head==null) {
			System.out.println("List empty!");
			return d;
		}
		intDoubly deletable,itr=head;
		while(itr.getNext()!=null) {
			itr=itr.getNext();
		}
		deletable=itr.getNext();
		d=deletable.getData();
		deletable.setPrev(null);
		deletable=null;
		return d;
		
	}
	public int deleteByPos(int p) {
		int d=-999;
		if(head==null) {
			System.out.println("List empty!");
			return d;
		}
		if(p==1) {
			d=deleteFirst();
			return d;
		}
		intDoubly deletable,itr=head;
		for(int i=0;i<p-1&&itr.getNext()!=null;i++) {
			itr=itr.getNext();
		}
		deletable=itr.getNext();
		d=deletable.getData();
		if(itr.getNext()!=null) {
			itr.setNext(deletable.getNext());
			deletable.getNext().setPrev(itr);
		}
		deletable.setPrev(null);
		deletable.setNext(null);
		deletable=null;
		return d;
	}
	public void display() {
		if(head==null) {
			System.out.println("List is empty!");
		}
		intDoubly itr=head;
		while(itr!=null) {
			System.out.print(itr.getData()+"->");
			itr=itr.getNext();
		}
		System.out.println();
	}
	
}

public class DoubleLinked {
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		DoublyyList doubly=new DoublyyList();
		int ch=0,n,p,del;
		do {
			System.out.println("1.InsertFirst\n2.InsertLast\n3.InsertByPos\n4.DeleteFirst\n5.DeleteLast\n6.DeleteByPos\n7.Display\n8.Exit");
			System.out.println("Enter your choice..");
			ch=sc.nextInt();
			switch(ch) {
			case 1:
				System.out.println("Enter element to insert: ");
				n=sc.nextInt();
				doubly.insertFirst(n);
				break;
			case 2:
				System.out.println("Enter element to insert: ");
				n=sc.nextInt();
				doubly.insertLast(n);
				break;
			case 3:
				System.out.println("Enter element and position to insert: ");
				n=sc.nextInt();
				p=sc.nextInt();
				doubly.insertByPos(n, p);
				break;
			case 4:
				del=doubly.deleteFirst();
				System.out.println(del+" deleted!");
				break;
			case 5:
				del=doubly.deleteLast();
				System.out.println(del+" deleted!");
				break;
			case 6:
				System.out.println("Enter position of node to delete :");
				p=sc.nextInt();
				del=doubly.deleteByPos(p);
				System.out.println(del+" deleted!");
				break;
				
			case 7:
				doubly.display();
				break;
			case 8:
				System.out.println("Existing.");
				break;
			default:
				System.out.println("Invalid choice!!");
			}
		}while(ch!=7);
		
	}
}
