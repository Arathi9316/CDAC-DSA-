package linkedlizt;

import java.util.Scanner;

class intNode{
	private int data;
	private intNode next;
	public intNode() {
		data=0;
		next=null;
	}
	public intNode(int d) {
		data =d;
		next=null;
	}
	public void setData(int d) {
		this.data=d;
	}
	public void setNext(intNode n) {
		this.next=n;
	}
	public int getData()
	{	
		return data;
	}
	public intNode getNext() {
		return next;
	}
}
	class LinkedLst{
		private intNode head;
		public LinkedLst() {
			head=null;
		}
		public void insertFirst(int d) {
			intNode new_node=new intNode(d);
			if(head==null) {
				head=new_node;
				return;
			}
			new_node.setNext(head);
			head=new_node;
			return;
		}
		
		public void insertLast(int d) {
			intNode new_node=new intNode(d);
			if(head==null) {
				head=new_node;
				return;
			}
			intNode itr=head;
			while(itr.getNext()!=null) {
				itr=itr.getNext();
			}
				itr.setNext(new_node);
				return;
			
		}
		public void insertByPosition(int d,int p) {
			intNode new_node=new intNode(d);
			if(head==null) {
				head=new_node;
				return;
			}
			if(p==1) {
				new_node.setNext(head);
				head=new_node;
				return;
			}
			intNode itr=head;
			for(int i=1;i<p-1&&itr.getNext()!=null;i++) {
				itr=itr.getNext();
			}
			new_node.setNext(itr.getNext());
			itr.setNext(new_node);
			return;
				
		}
		
		public void insertSorted(int d) {
			intNode new_node=new intNode(d);
			if(head==null) {
				head=new_node;
				return;
			}
			if(d<head.getData()) {
				new_node.setNext(head.getNext());
				head=new_node;
				return;
				
			}
			intNode itr=head;
			while(itr.getNext()!=null&&itr.getData()<d) {
				itr=itr.getNext();
				new_node.setNext(itr.getNext());
				itr.setNext(new_node);
				return;
				
			}
		}
		
		public void insertBefore(int d,int key) {
			intNode new_node=new intNode(d);
			if(head==null) {
				head=new_node;
				return;
			}
			if(head.getData()==key) {
				new_node.setNext(head.getNext());
				head=new_node;
				return;
			}
			intNode itr=head;
			while(itr.getNext()!=null && itr.getNext().getData()!=key)
				itr=itr.getNext();
			if(itr.getNext()!=null) {
				new_node.setNext(itr.getNext());
				itr.setNext(new_node);
			}
			else {
				System.out.println("Invalid key..");
				return;
			}
		}
		
		
		public void insertAfter(int d,int key) {
			intNode new_node=new intNode(d);
			if(head==null) {
				System.out.println("List is empty..");
				return;
			}
			if(head.getData()==key) {
				head.setNext(new_node);
				return;
			}
			
			intNode itr=head;
			while(itr.getNext()!=null && itr.getData()!=key)
				itr=itr.getNext();
			if(itr.getNext()!=null) {
				new_node.setNext(itr.getNext());
				itr.setNext(new_node);
			}
			else {
				System.out.println("Invalid key..");
				return;
			}
		}
		
		
		public void display() {
			if(head==null) {
				System.out.println("List is empty..");
				return;
			}
			intNode itr=head;
			while(itr!=null) {
				System.out.print(itr.getData()+"->");
				itr=itr.getNext();
			}
			System.out.println();
			return;
		}
		
		public int deleteFirst() {
			if(head==null) {
				System.out.println("List is empty!!");
				return -999;
			}
			intNode deletable;
			deletable=head;
			int d=deletable.getData();
			head=head.getNext();
			deletable.setNext(null);
			return d;
		}
		
		
		public int deleteLast() {
			if(head==null) {
				System.out.println("Empty list!");
				return -999;
			}
			intNode itr=head;
			int d;
			if(head.getNext()==null) {
				d=head.getData();
				head=null;
				return d;
				
			}
			intNode deletable;
			while(itr.getNext().getNext()!=null) {
				itr=itr.getNext();
			}
			deletable=itr.getNext();
			 d=deletable.getData();
			 deletable=null;
			 itr.setNext(null);
			return d;
			
		}
		
		public int delete_byPosition(int pos) {
			int d=-999;
			if(head==null) {
				System.out.println("Empty list!!");
				return d;
			}
			if(pos==1) {
				d=head.getData();
				head=null;
				return d;
			}
			intNode itr=head,deletable;
			int i=1;
			for(;i<pos-1&&itr.getNext()!=null;itr=itr.getNext(),i++);
			deletable=itr.getNext();
			if(itr.getNext()!=null) {
				itr.setNext(deletable.getNext());
				d=deletable.getData();
				deletable.setNext(null);
				return d;
			}
			else {
				System.out.println("Position invalid!");
				return d;
			}
			
		}
		
		public void deleteList() {
			if(head==null) {
				System.out.println("List already empty!");
			}
			intNode itr=head;
			while(itr.getNext()!=null) {
				itr=itr.getNext();
				itr.setNext(null);
			}
			head=null;
		}
		
		public int countNodes() {
			int count=0;
			if(head==null) {
				return count;
			}
			intNode itr=head;
			while(itr!=null) {
				itr=itr.getNext();
				count++;
			}
			return count;
			
		}
		
		public void displayAlternate() {
			if(head==null) {
				System.out.println("List is empty!");
			}
			intNode itr=head;
			while(itr.getNext()!=null) {
				itr=itr.getNext().getNext();
				System.out.println(itr.getData());
			}
		}
		
	}
	


