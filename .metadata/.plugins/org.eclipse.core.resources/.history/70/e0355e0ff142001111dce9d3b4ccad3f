package linkedlizt;
import java.util.*;

class CycleList extends LinkedLst{
	//private intNode head;
	public CycleList() {
		super();
		
	}
	public CycleList(intNode head) {
		super(head);
	}
	
	public void formCycle(int d) {
		intNode psave = null;
		intNode temp=head;
		
		while(temp.getNext()!=null) {
			if(temp.getData()==d) psave=temp;
			temp=temp.getNext();
		}
		if(psave!=null)
		temp.setNext(psave);
	}
	public void detectCycle() {
		intNode slow,fast,c=null;
		slow=fast=head;
		while(fast!=null&&fast.getNext()!=null) {
			slow=slow.getNext();
			fast=fast.getNext().getNext();
			c=slow;
			if(slow==fast) {
				System.out.println("Cycle detected!");
				System.out.println("Cycle detected at node : "+c);
				return;
			}
		}
	}
	
	public void deattachCycle() {
		intNode slow,fast,c=null,p1,p2;
		
		int lenCyl=0, remLen=0;
		slow=fast=head;
		while(fast!=null&&fast.getNext()!=null) {
			slow=slow.getNext();
			fast=fast.getNext().getNext();
			c=slow;
			if(slow==fast)break;
		}
		
		p1=p2=c;
		do {
			lenCyl++;
			p2=p2.getNext();
		}while(p1!=p2);
		System.out.println("Length of cycle : "+lenCyl);
		
		
		
		p1=head;
		while(p1!=p2) {
			remLen++;
			p1=p1.getNext();
			p2=p2.getNext();
		}
		System.out.println("Remaining length : "+remLen);
		
		int totalLen=lenCyl+remLen;
		p1=head;
		
		for(int i=1;i<totalLen;i++) {
			p1=p1.getNext();
		}
		p1.getNext().setNext(null);
		
		
	}
}



